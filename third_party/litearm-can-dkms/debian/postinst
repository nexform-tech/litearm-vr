#!/bin/sh
set -e
NAME=litearm-can
VER="@VERSION@"
case "$1" in
configure)
    if ! command -v dkms >/dev/null 2>&1; then
        echo "litearm-can-dkms: dkms not found; the stock gs_usb stays in use" >&2
        exit 0
    fi
    if [ ! -d "/lib/modules/$(uname -r)/build" ]; then
        echo "litearm-can-dkms: kernel headers for $(uname -r) are missing; install linux-headers-$(uname -r), then run: dpkg-reconfigure litearm-can-dkms" >&2
        exit 0
    fi
    # Re-registering the same version (reinstall/upgrade) must not fail.
    dkms status -m "$NAME" -v "$VER" 2>/dev/null | grep -q . || dkms add -m "$NAME" -v "$VER" || true
    if dkms install -m "$NAME" -v "$VER" --force; then
        # Replace the running gs_usb (stock, or a stale manual one) with the
        # installed module.  Fails harmlessly if something holds it open.
        if modprobe -r gs_usb 2>/dev/null; then
            modprobe gs_usb || true
        else
            echo "litearm-can-dkms: gs_usb is in use; the new driver takes effect after replug or reboot" >&2
        fi
    else
        # Never block the install: the board may work with the stock driver,
        # and litearm-can-selftest reports it clearly if it does not.
        echo "litearm-can-dkms: build failed for $(uname -r) (see /var/lib/dkms/$NAME/$VER/build/make.log); stock gs_usb stays in use" >&2
    fi
    ;;
esac
exit 0

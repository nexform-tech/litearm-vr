# litearm-vr-bridge 配置示例
#
# 用法：
#   sudo ./scripts/install.sh                        # 自动拷到 /etc/litearm-vr-bridge.env
#   cp deploy/bridge.env.example /etc/litearm-vr-bridge.env && 按需修改
#
# 全部配置项与默认值见 docs/DESIGN.md 第 7 节；这里只列常用项。
#
# ⚠ 格式：KEY=VALUE，一行一个，**不支持行尾注释**（systemd 的 EnvironmentFile 就是这么
#   读的，注释要单独占一行；up.sh 用的是同一套语义）。值里有空格就加引号。
#   不是 shell，别写 $(...) 或反引号。
#
# ⚠ 安全：默认是按真机起的（桥给 launcher 传了 `--real`）。它启动时**不会自动 home**，
#   首次按 grip 才会 movej 回 q_home 再跟随；真机需先上电并写好重力补偿参数。
#   只想跑仿真、不碰真机，就把 TELEOP_ARM_HOST 显式留空（= 后面什么都不写）。
#
# ⚠ 从旧版升上来的话：上游改名叫 teleop 之后，这里的变量名从 `METAVR_*` 换成了
#   `TELEOP_*`。桥**暂时仍认旧名字**（并在启动日志与 `--doctor` 里提示），但那是
#   兜底，不是长久之计 —— 其中两个的语义是"不要这样做"，留在旧名字上等于把
#   "我明确不要"寄托在一个将来会删的兼容层上：
#       METAVR_CMD=        → TELEOP_CMD=          （留空 = 这个进程桥不托管）
#       METAVR_ARM_HOST=   → TELEOP_ARM_HOST=     （留空 = 只跑仿真，不接真机）
#   注意 `METAVR_PY` 换的名字不一样：它现在叫 `TELEOP_SERVER_PY`（指上游服务端那个
#   metavr-arm 解释器），别和 `TELEOP_LAUNCH_PY`（跑 launcher 的解释器）搞混。

# ── 头显入口（**只有头显**连这里；上位机走 zenoh，不经过这个口） ──
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# ── 对内目标 ──
# teleop 自带 --port 参数，从 8765 改到 8766 即可，不需要改它的代码
TELEOP_ENDPOINT=127.0.0.1:8766
FOLLOW_SERVER_ENDPOINT=127.0.0.1:9001

# ── zenoh（对外的两条边：帧给 teleop、状态与动作给上位机） ──
# 话题长这样（`{arm}` 就是下面的 ZENOH_ARM_ID）：
#   litearm/v4/{arm}/vr_frame   桥 pub → teleop 订阅（头显原始帧，~90Hz）
#   litearm/v4/{arm}/vr_status  桥 pub → 上位机订阅（状态快照，STATUS_HZ）
#   litearm/v4/{arm}/vr_rpc     桥 queryable ← 上位机（动作，一问一答）
#
# ⚠ ZENOH_ARM_ID 要和 teleop、上位机填的**一致**，也要和 litearm-server 的
#   --arm-id 一致 —— 它决定大家在不在一棵话题树上。
ZENOH_ARM_ID=armA
# 会话模式。peer = 既连出去也让人连进来（teleop 与同机的 ctl 都靠后者）；
# client 会把"等对端连进来"这条掐掉，一般不要改。
ZENOH_MODE=peer
# 桥听在这。默认全网卡：上位机那台机器上的 zenoh router 要连得进来。
# ⚠ litearm-server 默认也监听 tcp/127.0.0.1:7447 —— 同机部署时改这里。
#   写 `ZENOH_LISTEN_ENDPOINTS=`（留空）= 不听任何端口。
ZENOH_LISTEN_ENDPOINTS=tcp/0.0.0.0:7447
# 主动连谁。留空 = 只等对端连进来。现场由 router 反向连本机时不用填。
# ZENOH_CONNECT_ENDPOINTS=tcp/192.168.31.1:7447
# 动作的应答上限（秒）。冷启动 teleop.start 要等端口 + 等上游约 14s，别往小调 ——
# 调小了会出现"动作其实成功了、上位机却报超时"。
ZENOH_REPLY_TIMEOUT_S=20

# ── 阈值与频率 ──
# FRAME_WARN_MS：超过则黄色告警"帧流异常"
FRAME_WARN_MS=200
# FRAME_FALLBACK_MS：超过则 hold 就地保持（红色告警 + 兜底态，不 movej）
FRAME_FALLBACK_MS=500
# FALLBACK_ENABLED=0 只告警、不自动 hold（排障用，别在生产关）
FALLBACK_ENABLED=1
# STATUS_HZ：上位机状态推送频率；3D 预览想更平滑可提到 20~30
STATUS_HZ=10
# PING_HZ：轮询跟随服务 9001 的频率（ping 拿 q/state/fault）
PING_HZ=4
# EVENT_TTL_MS：事件在快照里保留多久
EVENT_TTL_MS=20000
# FORWARD_TIMEOUT_MS：单帧转发写超时；超时即丢帧并重连 teleop
FORWARD_TIMEOUT_MS=500

# ── 真机状态来源 ──
# DESIGN 8.1 待实测前，唯一可用的默认值是 follow_server（9001 的 ping）
ARM_SOURCE=follow_server

# ── 日志 ──
LOG_LEVEL=INFO
# LOG_FORMAT=text | json
LOG_FORMAT=text
# LOG_FILE=/var/log/litearm-vr-bridge/bridge.log

# ── 进程启停（M3）──
# 默认起停的是**上游自己的启动脚本**，两个 submodule 就在仓库里，路径不用配：
#   teleop         → submodules/litearm-vr-teleop/teleop/launch/run_teleop_webxr.py
#   follow_server  → submodules/litearm-vr-follow/run_stm32_server.sh（sdk 是 run_sdk_server.sh）
# 详见 README「上游从哪来」；没 init 的话先 `git submodule update --init`。
#
# 上游放在 submodule 之外时才需要下面两个（指到**上游仓根**）：
# TELEOP_REPO=/opt/litearm-vr-teleop
# FOLLOW_REPO=/opt/litearm-vr-follow
#
# ⚠ teleop 仓 2026-10-15 重构：代码移进了 `teleop/` 子目录，启动脚本从
#   `scripts/run_teleop_webxr.sh` 换成 `launch/run_teleop_webxr.py`，**参数取代了
#   环境变量**（默认值在 `teleop/config/teleop.yaml`）。所以下面这些 TELEOP_* 桥只
#   翻译成命令行参数，环境准备（找解释器 / source ROS2 / 起 rviz / 清残留 / 查端口）
#   全归那个 launcher —— 上游的环境知识只有一份，桥不复制。
#
# 想完全自己控制命令行，就给下面两个（值里有空格要加引号）；
# 显式留空（= 后面什么都不写）表示"这个进程桥不托管"：桥只做转发/状态/兜底，
# teleop.start 也不会去拉起它。
# TELEOP_CMD=
# FOLLOW_SERVER_CMD=

# ── teleop（litearm-vr-teleop）──
# TELEOP_ARM_HOST：真机 arm_follow_server 的地址；留空 = 只跑 pybullet 仿真
TELEOP_ARM_HOST=127.0.0.1:9001
# TELEOP_SIDE=1 单臂水平侧装（当前真机）；正装设 0
TELEOP_SIDE=1
# TELEOP_DUAL=1 双臂侧装立柱（与 TELEOP_SIDE 互斥，二选一）
# TELEOP_DUAL=0
# TELEOP_DUAL_UPRIGHT=1 配 TELEOP_DUAL：双臂正装（两只独立竖直臂、无立柱）
# TELEOP_DUAL_UPRIGHT=0
# TELEOP_VIEWER=gui（pybullet 窗口，需要图形会话）| rviz（RViz2，需 ROS2）
TELEOP_VIEWER=gui
# TELEOP_IK：留空 = 上游默认 pin（pinocchio 微分 IK）；要回退旧实现设 pybullet
# TELEOP_IK=
# TELEOP_BIND_HOST：teleop 监听在哪，默认 127.0.0.1
# TELEOP_BIND_HOST=127.0.0.1
# TELEOP_SERVER_PY：metavr-arm 那个解释器的路径（转成 launcher 的 --metavr-py）；
# 留空 = launcher 自己解析（先看已激活的 conda 环境，再探常见位置）
# TELEOP_SERVER_PY=
# TELEOP_HAND=1 启用灵巧手（trigger 边沿 → 握拳/张开，经远端 TCP）
# ⚠ 驱动已经移到 follow 仓的 hand_server.py；CAN 口在**那台机器**上配，不是这台
# TELEOP_HAND=0
# TELEOP_HAND_REMOTE=127.0.0.1:9004   # hand_server.py 地址（默认 follow 主机 :9004）
# TELEOP_GRIPPER=1 启用夹爪（trigger 边沿 → 闭合/张开，经远端 TCP）
# TELEOP_GRIPPER=0
# TELEOP_GRIPPER_REMOTE=127.0.0.1:9003  # 夹爪服务地址（默认 follow 主机 :9003）

# ── follow_server（litearm-vr-follow）──
# FOLLOW_SERVER_MODE：stm32（串口，run_stm32_server.sh）| sdk（can0，run_sdk_server.sh）
FOLLOW_SERVER_MODE=stm32
FOLLOW_SERVER_SERIAL=/dev/ttyACM0
# FOLLOW_SERVER_CTRL_MODE：上游 follow_server 的 --mode，可选 jf/js/j/mit，上游默认 jf；
# 桥一直显式传 js（免调增益跟随）——要换控制律改这里，别改代码
# FOLLOW_SERVER_CTRL_MODE=js
# FOLLOW_SERVER_CAN=can0
# FOLLOW_SERVER_DRY_RUN=1 仅 sdk 模式支持，无硬件自测
PROCESS_LOG_DIR=/var/log/litearm-vr-bridge

# ── 关停行为 ──
# 1 = 本服务退出时先 latch（若正在跟随）再停掉自己拉起的子进程
STOP_PROCESSES_ON_EXIT=1
